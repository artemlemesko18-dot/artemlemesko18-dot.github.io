# Скопируйте этот файл в .env и заполните. Файл .env никому не передавайте.

# Порт сервера (за nginx/Caddy обычно 3000)
PORT=3000

# --- Админка /admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=придумайте-длинный-пароль

# --- Telegram-бот для заявок (см. README → «Подключение Telegram-бота») ---
TELEGRAM_BOT_TOKEN=
# Можно несколько через запятую: ваш личный chat_id и id группы
TELEGRAM_CHAT_ID=

# --- Дублирование заявок на e-mail (необязательно) ---
# Пример для Яндекс.Почты: smtp.yandex.ru, порт 465, пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# --- За прокси (nginx/Caddy) ---
# 1 — брать IP покупателя из X-Forwarded-For (нужно для лимита заявок)
TRUST_PROXY=1
# 1 — перенаправлять http → https и включить HSTS
FORCE_HTTPS=0

# Сколько заявок можно отправить с одного IP за 10 минут
ORDER_LIMIT=5
